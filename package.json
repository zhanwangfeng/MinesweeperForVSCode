{
  "name": "minesweeper-for-vscode",
  "displayName": "Minesweeper for VSCode",
  "description": "A classic Minesweeper game inside VSCode with difficulty TreeView and i18n (en/cn).",
  "version": "1.0.1",
  "publisher": "zhanwangfeng",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "mine",
    "minesweeper",
    "game",
    "扫雷",
    "游戏"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "minesweeper",
          "title": "%view.container.title%",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "minesweeper": [
        {
          "id": "minesweeper.difficulty",
          "name": "%view.difficulty.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "minesweeper.openGame",
        "title": "%command.openGame.title%",
        "icon": "$(play)",
        "category": "Minesweeper"
      },
      {
        "command": "minesweeper.restart",
        "title": "%command.restart.title%",
        "icon": "$(refresh)",
        "category": "Minesweeper"
      },
      {
        "command": "minesweeper.setLanguage",
        "title": "%command.setLanguage.title%",
        "category": "Minesweeper"
      },
      {
        "command": "minesweeper.selectDifficulty",
        "title": "%command.selectDifficulty.title%",
        "category": "Minesweeper"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "minesweeper.restart",
          "when": "resourceLangId == minesweeper-game",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "minesweeper.openGame",
          "when": "view == minesweeper.difficulty",
          "group": "navigation"
        },
        {
          "command": "minesweeper.setLanguage",
          "when": "view == minesweeper.difficulty",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "minesweeper.selectDifficulty",
          "when": "view == minesweeper.difficulty && viewItem == difficulty",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Minesweeper",
      "properties": {
        "minesweeper.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "cn"
          ],
          "default": "auto",
          "description": "%config.language.desc%"
        }
      }
    },
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese (Simplified)",
        "localizedLanguageName": "简体中文",
        "translations": [
          {
            "id": "minesweeper-for-vscode",
            "path": "./package.nls.zh-cn.json"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
